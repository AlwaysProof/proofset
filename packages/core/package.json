{
  "name": "@alwaysproof/proofset",
  "version": "0.1.7",
  "license": "MIT",
  "description": "Create and verify cryptographic proof sets for file integrity — library and CLI",
  "keywords": [
    "proofset",
    "hash",
    "checksum",
    "integrity",
    "verification",
    "commitment",
    "selective-disclosure",
    "proof",
    "attestation",
    "sha256",
    "sha512",
    "cryptography",
    "file-integrity",
    "data-integrity"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alwaysproof/proofset.git",
    "directory": "packages/core"
  },
  "type": "module",
  "bin": {
    "proofset": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./hashers/node": {
      "import": "./dist/hashers/node.js",
      "require": "./dist/hashers/node.cjs"
    },
    "./hashers/wasm": {
      "import": "./dist/hashers/wasm.js",
      "require": "./dist/hashers/wasm.cjs"
    }
  },
  "peerDependencies": {
    "hash-wasm": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "hash-wasm": {
      "optional": true
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "rm -rf dist && tsup src/index.ts src/cli/index.ts src/hashers/node.ts src/hashers/wasm.ts --format esm,cjs --dts",
    "prepack": "cp ../../README.md ../../LICENSE .",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "fast-glob": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "hash-wasm": "^4.12.0",
    "tsup": "^8.0.0"
  }
}
